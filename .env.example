# Copy this file to a new file named .env and fill in the values.
# The .env file is ignored by git, so your secrets stay private.

# Needed from milestone 2 onward (recipe suggestions).
# Get it at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# The password you type to open the app. Choose something only you know.
APP_PASSWORD=

# Any long random text. Used by Flask to protect forms.
SECRET_KEY=change-me-to-something-long-and-random
